{
  "stripTashkeel": false,
  "wrapperStart": "﴿",
  "wrapperEnd": "﴾",
  "referenceFormat": "[{surah}:{verse}]",
  "normalizationRules": [
    {
      "id": "alef-madda-variants",
      "description": "unify various spellings of يا أيّها (ya ayyuha)",
      "pattern": "يا\\s+أيها",
      "flags": "g",
      "replacement": "يايها",
      "enabled": true
    },
    {
      "id": "ya-ayyuha-1",
      "description": "unify joined spelling ياأيها",
      "pattern": "ياأيها",
      "flags": "g",
      "replacement": "يايها",
      "enabled": true
    },
    {
      "id": "ya-ayyuha-2",
      "description": "unify joined spelling يأيها",
      "pattern": "يأيها",
      "flags": "g",
      "replacement": "يايها",
      "enabled": true
    },
    {
      "id": "salah",
      "description": "صلوة -> صلاة (salah short-alef spelling)",
      "pattern": "صلوة",
      "flags": "g",
      "replacement": "صلاة",
      "enabled": true
    },
    {
      "id": "zakah",
      "description": "زكوة -> زكاة (zakah short-alef spelling)",
      "pattern": "زكوة",
      "flags": "g",
      "replacement": "زكاة",
      "enabled": true
    },
    {
      "id": "hayah",
      "description": "حيوة -> حياة (hayah short-alef spelling)",
      "pattern": "حيوة",
      "flags": "g",
      "replacement": "حياة",
      "enabled": true
    },
    {
      "id": "mishkah",
      "description": "مشكوة -> مشكاة (mishkah short-alef spelling)",
      "pattern": "مشكوة",
      "flags": "g",
      "replacement": "مشكاة",
      "enabled": true
    },
    {
      "id": "thaal-ya-variant",
      "description": "توحيد الذي والذى",
      "pattern": "ذى",
      "flags": "g",
      "replacement": "ذي",
      "enabled": true
    }
  ],
